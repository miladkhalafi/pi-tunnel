# Dashboard base URL - for registration links, script, API (default: SERVER_URL or request host)
WEB_URL=https://dashboard.example.com

# SSH tunnel host - where Pis connect for reverse tunnel (default: host from WEB_URL)
# Use when SSH runs on a different host than the web app
SSH_TUNNEL_HOST=ssh.example.com

# Legacy - fallback for WEB_URL when not set
SERVER_URL=https://your-server.com

# Flask secret key - set a random value in production
SECRET_KEY=change-me-in-production

# First admin bootstrap - when both are set and no users exist, creates the first admin
# After first login, create more users from the Users page; then these can be unset
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password

# Path to private key for web terminal (overrides auto-generated key in ./data/.ssh/)
# Keys are auto-generated on first run if not provided
# SSH_PRIVATE_KEY_PATH=/app/.ssh/id_ed25519
# AUTO_GENERATE_KEYS=false  # Set to disable auto-generation (require manual key setup)

# Server public key - auto-derived from private key if not set
# Override with env var or path to .pub file when needed
# SERVER_PUBLIC_KEY=ssh-ed25519 AAAAC3...
# SERVER_PUBLIC_KEY_PATH=/app/.ssh/id_ed25519.pub

# SSH port on server for Pi tunnel connections (default: 2222)
# Injected into registration script for headless use
# SSH_SERVER_PORT=2222

# Username on the Raspberry Pi (default: pi)
# SSH_USERNAME=pi

# Port range for tunnel endpoints (default: 10022-10031, i.e. 10 Pis)
# Ensure docker-compose exposes the same ports if you change these
# PORT_START=10022
# PORT_COUNT=10

# Optional: use pre-built images from GHCR
# IMAGE=ghcr.io/miladkhalafi/pi-tunnel-sshd:latest
# WEB_IMAGE=ghcr.io/miladkhalafi/pi-tunnel-web:latest
